{
  "info": {
    "name": "Meridian Part B — Local Webhooks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local-only testing. Requires Postman supporting pm.require npm:crypto-js@4.2.0. Exact provider samples; dynamically signs raw request body."
  },
  "item": [
    {
      "name": "Quetzal — 01-charge-succeeded.json",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const CryptoJS = pm.require('npm:crypto-js@4.2.0');",
              "const t = Math.floor(Date.now()/1000).toString();",
              "const raw = pm.request.body.raw;",
              "const hmac = CryptoJS.HmacSHA256(t+'.'+raw, pm.environment.get('quetzalSecret')).toString(CryptoJS.enc.Hex);",
              "pm.request.headers.upsert({key:'Quetzal-Signature',value:'t='+t+',v1='+hmac});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Accepted or exact duplicate\", function () { pm.expect(pm.response.code).to.eql(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"evt_01JDQ3K8M2X7\",\n  \"type\": \"charge.succeeded\",\n  \"api_version\": \"2025-06-01\",\n  \"created\": 1795888800,\n  \"data\": {\n    \"charge\": {\n      \"id\": \"ch_7Hk2Lm9QpZ\",\n      \"amount\": 125000,\n      \"currency\": \"mxn\",\n      \"status\": \"succeeded\",\n      \"reference\": \"POL-MX-000412785\",\n      \"paid_at\": 1795888796,\n      \"payment_method\": {\n        \"type\": \"card\",\n        \"token\": \"tok_qz_9sD2fK\"\n      },\n      \"customer\": {\n        \"email\": \"maria.lopez@example.com\"\n      }\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/webhooks/quetzal"
      }
    },
