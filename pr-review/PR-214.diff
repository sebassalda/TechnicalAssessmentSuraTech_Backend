+package com.meridian.payments.cl;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.atMost;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import com.meridian.payments.persistence.ProcessedNotificationRepository;
+import com.meridian.payments.salesforce.SalesforceClient;
+
+@ExtendWith(MockitoExtension.class)
+class AustralPaymentServiceTest {
+
+    @Mock
+    private ProcessedNotificationRepository processedNotifications;
+
+    @Mock
+    private SalesforceClient salesforceClient;
+
+    @InjectMocks
+    private AustralPaymentService service;
+
+    @Test
+    void shouldProcessNotification() {
+        service.process(sampleNotification());
+
+        assertNotNull(service);
+    }
+
+    @Test
+    void shouldHandleDuplicates() {
+        when(processedNotifications.existsById(any())).thenReturn(true);
+
+        service.process(sampleNotification());
+
+        verify(salesforceClient, atMost(1)).createPayment(any());
+    }
+
+    @Test
+    void shouldHandleErrors() {
+        when(salesforceClient.findPaymentId(any(), any())).thenThrow(new RuntimeException("Salesforce down"));
+
+        assertDoesNotThrow(() -> service.process(sampleNotification()));
+    }
+
+    private AustralNotification sampleNotification() {
+        return new AustralNotification(
+                "aus_ev_93f0c1d2",
+                "PAYMENT_CONFIRMED",
+                "2026-11-28T17:05:44Z",
+                new AustralNotification.Payment(
+                        "AUS-P-77120",
+                        45990,
+                        "CLP",
+                        "POL-CL-000093311",
+                        "2026-11-28T17:05:40Z",
+                        new AustralNotification.Payer("Camila Rojas", "11.111.111-1", "camila.rojas@example.com")));
+    }
+}
