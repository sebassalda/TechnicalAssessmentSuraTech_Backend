+package com.meridian.payments.cl;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.Optional;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.meridian.payments.persistence.ProcessedNotification;
+import com.meridian.payments.persistence.ProcessedNotificationRepository;
+import com.meridian.payments.salesforce.PremiumPaymentRecord;
+import com.meridian.payments.salesforce.SalesforceClient;
+
+@Service
+public class AustralPaymentService {
+
+    private static final Logger log = LoggerFactory.getLogger(AustralPaymentService.class);
+    private static final String PROVIDER = "Austral";
+
+    private final ProcessedNotificationRepository processedNotifications;
+    private final SalesforceClient salesforceClient;
+
+    public AustralPaymentService(ProcessedNotificationRepository processedNotifications,
+                                 SalesforceClient salesforceClient) {
+        this.processedNotifications = processedNotifications;
+        this.salesforceClient = salesforceClient;
+    }
+
+    @Transactional
+    public void process(AustralNotification notification) {
+        try {
+            if (processedNotifications.existsById(notification.eventId())) {
+                log.info("Duplicate Austral event {}, skipping", notification.eventId());
+                return;
+            }
+
+            AustralNotification.Payment payment = notification.payment();
+            String status = mapStatus(notification.eventType());
+
+            Optional<String> existingPaymentId = salesforceClient.findPaymentId(PROVIDER, payment.paymentId());
+            if (existingPaymentId.isPresent()) {
+                salesforceClient.updatePaymentStatus(existingPaymentId.get(), status);
+            } else {
+                salesforceClient.createPayment(new PremiumPaymentRecord(
+                        payment.policyNumber(),
+                        BigDecimal.valueOf(Math.round(payment.amount() * 100) / 100.0),
+                        payment.currency(),
+                        status,
+                        PROVIDER,
+                        payment.paymentId(),
+                        Instant.parse(payment.occurredAt())));
+            }
+
+            processedNotifications.save(new ProcessedNotification(notification.eventId(), Instant.now()));
+        } catch (Exception e) {
+            log.error("Error processing Austral event " + notification.eventId(), e);
+        }
+    }
+
+    private String mapStatus(String eventType) {
+        return switch (eventType) {
+            case "PAYMENT_CONFIRMED" -> "Captured";
+            case "PAYMENT_REJECTED" -> "Failed";
+            case "PAYMENT_REVERSED" -> "Refunded";
+            default -> "Pending";
+        };
+    }
+}
